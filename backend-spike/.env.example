# Salin ke .env lalu isi. JANGAN commit .env.
APP_ENV=development
LOG_FORMAT=console
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Lokal (docker-compose.local.yml): postgresql://postgres:postgres@localhost:54329/bersama
# Supabase: pakai connection string Postgres proyek (Settings > Database). Bila lewat pooler
# mode transaksi, set DB_STATEMENT_CACHE_SIZE=0.
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/bersama
DB_STATEMENT_CACHE_SIZE=100

# Supabase Auth
# Cloud: https://<project-ref>.supabase.co. Lokal: kosongkan bila memakai seed_demo.
SUPABASE_URL=
# Publishable/anon key only. JANGAN gunakan SUPABASE_SERVICE_ROLE_KEY di API.
SUPABASE_ANON_KEY=
# Must exactly match the callback URL configured in Supabase Auth settings.
SUPABASE_OAUTH_REDIRECT_URL=http://localhost:8000/v1/auth/callback
# Random secret used to sign short-lived OAuth state values. Keep stable across API instances.
SUPABASE_OAUTH_STATE_SECRET=
SUPABASE_OAUTH_PROVIDERS=google,github
SUPABASE_AUTH_TIMEOUT_SECONDS=10

# Isi SALAH SATU: JWKS (kunci penandatanganan asimetris) atau secret HS256.
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=ganti-dengan-secret-lokal-minimal-32-karakter
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=

# fake = demo/tes offline tanpa API key. litellm = provider nyata (pip install -e ".[llm]").
LLM_BACKEND=fake
LLM_FREE_PRIMARY_MODEL=
LLM_FREE_FALLBACK_MODEL=
LLM_PRO_PRIMARY_MODEL=
LLM_PRO_FALLBACK_MODEL=
LLM_FREE_TIER_API_KEY=
LLM_PRO_API_KEY=
LLM_FALLBACK_API_KEY=
EMBEDDING_BACKEND=hashing
EMBEDDING_MODEL=hashing-768
EMBEDDING_DIM=768
DEMO_REPLAY=false

EXTRACT_BATCH_SIZE=20
EXTRACT_IDLE_SECONDS=60